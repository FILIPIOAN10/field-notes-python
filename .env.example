# Choose one provider: anthropic | lovable | bedrock | mock
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-5-5      # default
# CLAUDE_EFFORT=low                   # default; medium | high for more depth, empty for models without effort

# lovable = the model is called through the Field Notes web app, no API key needed here:
# LLM_PROVIDER=lovable
# LOVABLE_PROXY_TOKEN=<token from the web app's PYTHON_PROXY_TOKEN secret>

# AWS Bedrock (Messages API endpoint, uses your AWS credentials / region):
# LLM_PROVIDER=bedrock
# AWS_REGION=eu-central-1
# CLAUDE_MODEL=anthropic.claude-sonnet-5-5

# mock = deterministic offline fake model, for demos and tests:
# LLM_PROVIDER=mock
